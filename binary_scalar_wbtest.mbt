///|
test "Python binary scalar vectors preserve types" {
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303009080000000000000101000000000000000100000000000000000000000000000009",
      ),
    ) ==
    Boolean(true),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303008080000000000000101000000000000000100000000000000000000000000000009",
      ),
    ) ==
    Boolean(false),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303000080000000000000101000000000000000100000000000000000000000000000009",
      ),
    ) ==
    Null,
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c6973743030100008000000000000010100000000000000010000000000000000000000000000000a",
      ),
    ) ==
    Integer(0L),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303013ffffffffffffffff080000000000000101000000000000000100000000000000000000000000000011",
      ),
    ) ==
    Integer(-1L),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303010ff08000000000000010100000000000000010000000000000000000000000000000a",
      ),
    ) ==
    Integer(255L),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303011010008000000000000010100000000000000010000000000000000000000000000000b",
      ),
    ) ==
    Integer(256L),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c69737430301400000000000000008000000000000000080000000000000101000000000000000100000000000000000000000000000019",
      ),
    ) ==
    Unsigned(9223372036854775808UL),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c6973743030140000000000000000ffffffffffffffff080000000000000101000000000000000100000000000000000000000000000019",
      ),
    ) ==
    Unsigned(18446744073709551615UL),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303023400a000000000000080000000000000101000000000000000100000000000000000000000000000011",
      ),
    ) ==
    Real(3.25),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c6973743030644e2d6587d83dde00080000000000000101000000000000000100000000000000000000000000000011",
      ),
    ) ==
    Text("中文😀"),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c69737430304200ff08000000000000010100000000000000010000000000000000000000000000000b",
      ),
    ) ==
    Data(b"\x00\xff"),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c697374303033bff0000000000000080000000000000101000000000000000100000000000000000000000000000011",
      ),
    ) ==
    Date(-1.0),
  )
  assert_true(
    decode_binary(
      decode_hex(
        "62706c6973743030802a08000000000000010100000000000000010000000000000000000000000000000a",
      ),
    ) ==
    Uid(42UL),
  )
}
